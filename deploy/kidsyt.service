[Unit]
Description=Hassle Free TV
After=network.target

[Service]
Type=simple
User=kidsyt
WorkingDirectory=/opt/kidsyt
ExecStart=/usr/bin/node --env-file=/opt/kidsyt/.env server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

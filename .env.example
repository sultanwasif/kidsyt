# Copy to .env and fill in. Never commit .env.

# OAuth 2.0 Client ID (Web application) from Google Cloud → Credentials
GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# API key restricted to "YouTube Data API v3" and to your VPS IP address
YT_API_KEY=AIza...

# Node listens only on localhost; nginx serves the public HTTPS site
PORT=3000
HOST=127.0.0.1

# How long each channel's video list is cached (shared by all families)
CACHE_MINUTES=60

DB_FILE=./data/kidsyt.db

# Set to false only for local testing over plain http
COOKIE_SECURE=true
